<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="maui_pokemon_list.View.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:maui_pokemon_list.Model"
             xmlns:viewmodel="clr-namespace:maui_pokemon_list.ViewModel"
             x:DataType="viewmodel:PokemonListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">
        <ListView ItemsSource="{Binding Pokemons}" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:PokemonModel">
                    <ViewCell>
                        <Frame Style="{StaticResource CardView}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:PokemonListViewModel}}, Path=GoToDetailsCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            <Label Text="{Binding name}" TextColor="Black"/>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}"
                           Grid.RowSpan="2"
                           Grid.ColumnSpan="2"/>
    </Grid>

</ContentPage>
