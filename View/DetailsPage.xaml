<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:maui_pokemon_list.Model"
             xmlns:viewmodel="clr-namespace:maui_pokemon_list.ViewModel"
             x:Class="maui_pokemon_list.View.DetailsPage"
             x:DataType="viewmodel:PokemonDetailsViewModel">
    <VerticalStackLayout>
        <Label Text="{Binding Title}"
               TextColor="black"/>
        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}"
                           Grid.RowSpan="2"
                           Grid.ColumnSpan="2"/>
        <Button Text="Get Details" 
                Command="{Binding GetDetailsCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource ButtonOutline}"
                Margin="8"/>
    </VerticalStackLayout>
</ContentPage>